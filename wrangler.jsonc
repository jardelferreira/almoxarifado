{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "almoxarifado",
  "compatibility_date": "2026-08-30",
  "compatibility_flags": ["nodejs_compat"],
  "main": "src/server.ts",
  "r2_buckets": [
    {
      "binding": "ALMOXARIFADO_BUCKET",
      "bucket_name": "almoxarifado"
      // Sem "remote": true, o wrangler dev usa o R2 local simulado.
      // O deploy continua vinculando o bucket R2 de produção.
    }
  ],
  "env": {
    "preview": {
      "name": "almoxarifado-preview",
      "r2_buckets": [
        {
          "binding": "ALMOXARIFADO_BUCKET",
          "bucket_name": "almoxarifado-preview",
          "remote": true
        }
      ]
    }
  }
}
