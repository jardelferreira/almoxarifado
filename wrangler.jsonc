{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "almoxarifado",
  "compatibility_date": "2026-08-30",
  "compatibility_flags": ["nodejs_compat"],
  "main": "@tanstack/react-start/server-entry",
  "r2_buckets": [
    {
      "binding": "ALMOXARIFADO_BUCKET",
      "bucket_name": "almoxarifado",
      "remote": true
    }
  ]
}